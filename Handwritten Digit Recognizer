import gradio as gr
import tensorflow as tf
import numpy as np
from PIL import Image, ImageOps

# Load your trained model
model = tf.keras.models.load_model("mnist_model.h5")

# Prediction function
def predict_digit(image):
    image = Image.fromarray(image).convert("L")  # Convert to grayscale
    image = image.resize((28, 28))               # Resize for MNIST
    image = ImageOps.invert(image)               # Invert to white bg, black digit
    img_array = np.array(image) / 255.0          # Normalize
    img_array = img_array.reshape(1, 28, 28, 1)   # Shape: (1, 28, 28, 1)
    prediction = model.predict(img_array)
    return {str(i): float(prediction[0][i]) for i in range(10)}

# Create the Gradio interface with Sketchpad (no shape, no brush_radius)
interface = gr.Interface(
    fn=predict_digit,
    inputs=gr.Sketchpad(),
    outputs=gr.Label(num_top_classes=3),
    title="🖍️ Handwritten Digit Recognizer",
    description="Draw a digit (0–9) on the canvas and get predictions from your CNN model!"
)

interface.launch(share=True)

